# ===========================================================================
#  Kite - what does NOT belong in the repository
# ===========================================================================
#  Everything excluded here is either regenerated by a build or is the build
#  product itself. The tree that remains is source: YRpp headers, src\, docs\,
#  the .vcxproj/.sln and kite.ini.
# ===========================================================================

# --- C++ build output ------------------------------------------------------
Debug/
Release/
*.obj
*.lib
*.exp
*.pdb
*.ilk
*.idb
*.iobj
*.ipdb
*.pgd
*.aps
*.tlog
*.lastbuildstate
*.log
*.user

# Kite.dll is the build product; it is deployed next to gamemd.exe, never
# committed from the source tree.
/Kite.dll
/kite.log
/kite.log.*

# --- editor / OS litter ----------------------------------------------------
.vs/
.vscode/
*.VC.db
*.VC.VC.opendb
*.suo
*.bak
*.orig
*.rej
Thumbs.db
desktop.ini
